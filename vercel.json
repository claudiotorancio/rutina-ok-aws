{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.mjs"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.mjs"
        },
        {
            "source": "/panel.html",
            "destination": "/api/index.mjs"
        },
        {
            "source": "/panel-admin",
            "destination": "/api/index.mjs"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/dist/$1"
        }
    ]
}