generator client {
  provider            = "prisma-client-js"
  output              = "./generated"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"] 
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   // Se guarda el JSON de la sesión
  expiresAt DateTime

  @@map("sessions")
}

model Usuario {
  id_usuario    Int            @id @default(autoincrement())
  nombre        String
  apellido      String
  email         String         @unique
  password      String
  telefono      String?
  tipo_usuario  TipoUsuario
  debe_cambiar_pass Boolean        @default(true) //
  creado_en     DateTime       @default(now())
  administrador Administrador?
  tecnico       Tecnico?

  @@map("usuarios")
}

model Administrador {
  id_usuario   Int     @id
  nivel_acceso String  @default("OPERADOR")
  departamento String?
  usuario      Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("administradores")
}

model Tecnico {
  id_usuario            Int                  @id
  especialidad          String?
  matricula             String?
  estado_disponibilidad EstadoDisponibilidad @default(DISPONIBLE)
  activo       Boolean      @default(true)
  ordenes               OrdenTrabajo[]
  usuario               Usuario              @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("tecnicos")
}

model Cliente {
  id_cliente      Int      @id @default(autoincrement())
  nombre_empresa  String
  contacto_nombre String?
  telefono        String?
  email           String?
  direccion       String
  activo          Boolean  @default(true)
  creado_en       DateTime @default(now())
  equipos         Equipo[]
  ordenes         OrdenTrabajo[]

  @@map("clientes")
}

model Equipo {
  id_equipo         Int            @id @default(autoincrement())
  id_cliente        Int
  nombre_equipo     String
  marca             String
  modelo            String
  numero_serie      String         @unique
  ubicacion_interna String?
  tipo_refrigerante String?
  activo            Boolean      @default(true)
  cliente           Cliente        @relation(fields: [id_cliente], references: [id_cliente])
  ordenes           OrdenTrabajo[]

  @@map("equipos")
}

model OrdenTrabajo {
  id_orden             Int               @id @default(autoincrement())
  id_cliente           Int
  id_equipo            Int?
  id_tecnico           Int 
  tipificacion         Tipificacion      @default(AIRE_ACONDICIONADO)
  estado               EstadoOrden       @default(PENDIENTE)
  prioridad            Prioridad         @default(BAJA)
  fecha_programada     DateTime
  descripcion_tarea    String
  comentario_respuesta String?
  fecha_respuesta      DateTime?
  creado_en            DateTime          @default(now())
  intervenciones       Intervencion[]
  cliente              Cliente          @relation(fields: [id_cliente], references: [id_cliente])
  equipo               Equipo?            @relation(fields: [id_equipo], references: [id_equipo])
  tecnico              Tecnico           @relation(fields: [id_tecnico], references: [id_usuario])

  @@map("ordenes_trabajo")
}

model Intervencion {
  id_intervencion   Int              @id @default(autoincrement())
  id_orden          Int              
  tipo              TipoIntervencion 
  //Los datos específicos de cada intervencion
  detalles_json     Json? 
  visto             Boolean          @default(false)
  orden             OrdenTrabajo     @relation(fields: [id_orden], references: [id_orden])
  creado_en         DateTime         @default(now())

  @@map("intervenciones")
}

enum TipoUsuario {
  ADMIN
  TECNICO
}

enum Tipificacion {
  AIRE_ACONDICIONADO
  INSTALACION_ELECTRICA
}

enum EstadoOrden {
  PENDIENTE
  REPROGRAMAR
  COMPLETADA
}

enum EstadoDisponibilidad {
  DISPONIBLE
  ASIGNADO
}

enum Prioridad {
  BAJA
  ALTA
}

enum TipoIntervencion {
  RECARGA_GAS
  PREVENTIVO
  CORRECTIVO
  INSTALACION_ELECTRICA
}
